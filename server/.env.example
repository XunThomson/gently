# gently 后端环境配置（复制为 .env 后按需修改）
# 全部变量由 src/config/env.ts 用 Zod 校验；缺失的可选依赖会自动降级。

# ---- 运行 ----
NODE_ENV=development
# 监听端口与地址（桌面端默认连 127.0.0.1）
PORT=8787
HOST=127.0.0.1
# 对外可见的基础路径，用于 OpenAPI server 与回调拼接
PUBLIC_BASE_URL=http://127.0.0.1:8787
LOG_LEVEL=info
# 允许的跨域来源，逗号分隔；桌面端为 tauri://localhost / http://localhost:1420
CORS_ORIGINS=tauri://localhost,http://localhost:1420,http://localhost:5173

# ---- 鉴权 ----
# openssl rand -base64 48
JWT_SECRET=change-me-in-production-change-me-in-production
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# ---- 数据（不配置则使用内存降级实现，服务仍可启动）----
DATABASE_URL=postgres://gently:gently@127.0.0.1:5432/gently
REDIS_URL=redis://127.0.0.1:6379

# ---- 限流 ----
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---- 音源插件 ----
# 插件目录（相对 server/ 或绝对路径），可放多个子目录，每个含 plugin.json
PLUGIN_DIR=plugins
# 单次音源请求超时（毫秒）
PLUGIN_REQUEST_TIMEOUT_MS=8000
