{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gently",
  "version": "0.1.0",
  "identifier": "com.xun.gently",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gently",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 260,
        "decorations": false,
        "shadow": false
      },
      {
        "label": "desktop-lyrics",
        "url": "index.html?window=desktop-lyrics",
        "title": "gently 桌面歌词",
        "width": 760,
        "height": 160,
        "minWidth": 420,
        "minHeight": 120,
        "center": true,
        "visible": false,
        "focus": false,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true
      },
      {
        "label": "pet",
        "url": "index.html?window=pet",
        "transparent": true,
        "title": "gently 宠物",
        "width": 200,
        "height": 160,
        "visible": false,
        "focus": false,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}



