{
  "meta": {
    "name": "Gently Default",
    "version": "1.0.0",
    "description": "全局 UI 样式元数据。所有主要渲染相关元数据（尺寸/颜色/字体/圆角/动效）都在此维护，运行时由 ThemeProvider 注入为 CSS 变量。"
  },

  "mode": "system",

  "palette": {
    "brand": "#6b4eff",
    "brandHover": "#5c3fe8",
    "brandSoft": "rgba(107, 78, 255, 0.10)",
    "brandContrast": "#ffffff",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444"
  },

  "scheme": {
    "light": {
      "app": "#f0f0f0",
      "surface": "#ffffff",
      "surfaceAlt": "#f3f4f6",
      "subtle": "#f7f8fa",
      "elevated": "#ffffff",
      "surfaceTranslucent": "rgba(255, 255, 255, 0.82)",
      "videoScrim": "rgba(244, 246, 250, 0.55)",
      "hover": "rgba(0, 0, 0, 0.04)",
      "active": "rgba(0, 0, 0, 0.08)",
      "textPrimary": "#1a1a1a",
      "textSecondary": "#6b7280",
      "textTertiary": "#9ca3af",
      "textInverse": "#ffffff",
      "borderSubtle": "#e5e7eb",
      "borderDefault": "#d1d5db",
      "borderStrong": "#9ca3af",
      "divider": "rgba(0, 0, 0, 0.08)",
      "scrollbarThumb": "#d9dde3"
    },
    "dark": {
      "app": "#121212",
      "surface": "#1e1e1e",
      "surfaceAlt": "#2a2a2a",
      "subtle": "#141414",
      "elevated": "#2a2a2a",
      "surfaceTranslucent": "rgba(20, 20, 24, 0.74)",
      "videoScrim": "rgba(8, 10, 14, 0.52)",
      "hover": "rgba(255, 255, 255, 0.06)",
      "active": "rgba(255, 255, 255, 0.10)",
      "textPrimary": "#ffffff",
      "textSecondary": "#d1d5db",
      "textTertiary": "#9ca3af",
      "textInverse": "#1a1a1a",
      "borderSubtle": "#3a3a3a",
      "borderDefault": "#4a4a4a",
      "borderStrong": "#6b7280",
      "divider": "rgba(255, 255, 255, 0.08)",
      "scrollbarThumb": "#3a3f46"
    }
  },

  "typography": {
    "fontFamilySans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "fontFamilyMono": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace",
    "fontSizeXs": "0.75rem",
    "fontSizeSm": "0.875rem",
    "fontSizeBase": "1rem",
    "fontSizeLg": "1.125rem",
    "fontSizeXl": "1.25rem",
    "fontSize2xl": "1.5rem",
    "fontSize3xl": "1.875rem",
    "fontSize4xl": "2.25rem",
    "lineHeightTight": 1.2,
    "lineHeightNormal": 1.5,
    "lineHeightRelaxed": 1.65,
    "weightNormal": 400,
    "weightMedium": 500,
    "weightSemibold": 600,
    "weightBold": 700
  },

  "radius": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "2xl": "24px",
    "full": "9999px"
  },

  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },

  "shadow": {
    "xs": "0 1px 2px rgba(16, 20, 28, 0.04)",
    "sm": "0 1px 3px rgba(16, 20, 28, 0.06), 0 1px 2px rgba(16, 20, 28, 0.04)",
    "md": "0 4px 12px -4px rgba(16, 20, 28, 0.10), 0 2px 4px -2px rgba(16, 20, 28, 0.06)",
    "lg": "0 16px 32px -16px rgba(16, 20, 28, 0.18), 0 4px 10px -6px rgba(16, 20, 28, 0.08)",
    "xl": "0 28px 56px -24px rgba(16, 20, 28, 0.24), 0 8px 18px -12px rgba(16, 20, 28, 0.10)",
    "panel": "0 20px 44px -20px rgba(16, 20, 28, 0.22), 0 2px 8px -4px rgba(16, 20, 28, 0.08)"
  },

  "motion": {
    "fast": "150ms ease",
    "base": "250ms ease",
    "slow": "350ms ease",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  },

  "zIndex": {
    "base": 0,
    "dropdown": 60,
    "overlay": 100,
    "modal": 200,
    "toast": 300
  },

  "components": {
    "titleBar": {
      "height": 60,
      "paddingX": 16,
      "logoFontSize": 20,
      "logoFontWeight": 700,
      "logoColor": "{text.primary}"
    },

    "searchBox": {
      "height": 38,
      "maxWidth": 520,
      "minWidth": 200,
      "radius": "12px",
      "fontSize": 14,
      "placeholderColor": "{text.tertiary}",
      "iconSize": 16,
      "iconColor": "{text.tertiary}",
      "submitTextColor": "{brand.contrast}",
      "panelMaxHeight": 380,
      "historyKey": "gently:search-history",
      "maxHistory": 10,
      "debounce": 250
    },

    "toolbar": {
      "buttonSize": 32,
      "iconSize": 18,
      "gap": 2,
      "paddingX": 8,
      "paddingY": 6,
      "radius": "10px",
      "iconColor": "{text.secondary}",
      "hoverColor": "{text.primary}",
      "hoverBg": "{bg.hover}",
      "dividerColor": "{border.subtle}"
    },

    "sidebar": {
      "width": 232,
      "padding": 12,
      "itemHeight": 38,
      "itemGap": 10,
      "itemPaddingX": 12,
      "itemRadius": "10px",
      "fontSize": 13.5,
      "iconSize": 16,
      "textColor": "{text.secondary}",
      "hoverTextColor": "{text.primary}",
      "hoverBg": "{bg.hover}",
      "activeTextColor": "{brand}",
      "activeBg": "{brand.soft}",
      "activeWeight": 500,
      "sectionTitleFontSize": 12,
      "sectionTitleColor": "{text.tertiary}",
      "groupGap": 16,
      "countFontSize": 12,
      "indicatorWidth": 3,
      "indicatorHeight": 16,
      "rowActionSize": 24,
      "emptyFontSize": 12
    },

    "playerBar": {
      "height": 84,
      "paddingX": 20,
      "coverSize": 48,
      "coverRadius": "12px",
      "controlSize": 38,
      "titleFontSize": 14,
      "metaFontSize": 12,
      "chipFontSize": 10,
      "iconButtonSize": 32,
      "volumeWidth": 84,
      "progressHeight": 3,
      "progressHoverHeight": 7,
      "progressThumbSize": 12,
      "progressThumbSkin": "glow",
      "progressTrackColor": "{border.subtle}",
      "progressFillColor": "{brand}",
      "progressGlowColor": "{brand.soft}"
    },

    "panel": {
      "width": 340,
      "maxHeight": 340,
      "padding": 16,
      "radius": "14px",
      "itemPaddingX": 8,
      "itemPaddingY": 8,
      "itemRadius": "6px",
      "indexWidth": 20,
      "chipPaddingX": 12,
      "chipPaddingY": 5
    },

    "button": {
      "radius": "10px",
      "iconGap": 8,
      "heightSm": 30,
      "heightMd": 36,
      "paddingXSm": 12,
      "paddingXMd": 16,
      "fontSizeSm": 12,
      "fontSizeMd": 14
    },

    "lyrics": {
      "fontSize": 15,
      "activeFontSize": 17,
      "lineGap": 14,
      "paddingX": 20,
      "paddingY": 40,
      "inactiveColor": "{text.tertiary}",
      "hoverColor": "{text.secondary}",
      "activeColor": "{brand}",
      "activeWeight": 600,
      "activeBg": "{brand.soft}",
      "guideColor": "{border.default}",
      "guideWidth": 1,
      "inactiveOpacity": 0.55,
      "linePaddingX": 12,
      "linePaddingY": 6
    },

    "menu": {
      "width": 232,
      "maxHeight": 300,
      "padding": 6,
      "radius": "12px",
      "itemPaddingX": 10,
      "itemPaddingY": 8,
      "itemRadius": "8px",
      "fontSize": 13
    },

    "sourceFilter": {
      "height": 32,
      "gap": 6,
      "tabPaddingX": 14,
      "fontSize": 13,
      "drawerWidth": 260
    },

    "emptyState": {
      "paddingX": 20,
      "paddingY": 40,
      "iconGap": 8,
      "iconColor": "{border.strong}",
      "titleFontSize": 14,
      "hintFontSize": 12
    },

    "radioGroup": {
      "gap": 24,
      "fontSize": 16,
      "underlineHeight": 2,
      "underlineOffset": 4,
      "underlineShortWidth": "50%",
      "color": "{text.secondary}",
      "hoverColor": "{text.primary}",
      "activeColor": "{brand}"
    },

    "hero": {
      "paddingX": 30,
      "paddingY": 26,
      "coverSize": 150,
      "coverRadius": "18px",
      "discSize": 56,
      "discDotSize": 12,
      "titleFontSize": 26,
      "tagFontSize": 11.5,
      "glowColor": "{brand.soft}"
    },

    "datePicker": {
      "cellSize": 32,
      "panelPadding": 8,
      "chipHeight": 30,
      "chipPaddingX": 8
    },

    "background": {
      "enabled": true,
      "opacity": 0.55,
      "blurPx": 0,
      "scrim": "{scrim}",
      "surfaceBlurPx": 22
    },

    "view": {
      "titleFontSize": 26,
      "titleFontWeight": 700,
      "titleSpacing": "-0.02em",
      "subtitleFontSize": 13,
      "headerGap": 16,
      "paddingX": 28,
      "paddingY": 24,
      "gap": 20,
      "maxWidth": 1440
    },

    "section": {
      "titleFontSize": 18,
      "subtitleFontSize": 13,
      "gap": 16,
      "marginBottom": 32
    },

    "dataTable": {
      "fontSize": 13.5,
      "headerFontSize": 12,
      "headerColor": "{text.tertiary}",
      "headerSpacing": "0.02em",
      "cellPaddingX": 18,
      "cellPaddingY": 11,
      "rowMinHeight": 46,
      "radius": "14px",
      "rowHoverBg": "{bg.hover}",
      "borderColor": "{border.subtle}",
      "emptyPaddingY": 48,
      "indicatorWidth": 3,
      "indicatorHeight": 20,
      "actionGap": 4,
      "actionPaddingX": 8,
      "actionPaddingY": 4,
      "actionRadius": "6px"
    },

    "card": {
      "radius": "16px",
      "gap": 20,
      "minWidth": 168,
      "coverRatio": 1,
      "titleFontSize": 14,
      "metaFontSize": 12.5,
      "initialFontSize": 26,
      "playSize": 34,
      "playInset": 9,
      "hoverLift": "-3px"
    },

    "topList": {
      "rankColumnWidth": 34,
      "coverColumnWidth": 44,
      "coverRadius": "10px",
      "durationColumnWidth": 52,
      "rowPaddingY": 11,
      "rowPaddingX": 18,
      "hoverBg": "{bg.hover}",
      "playingBg": "{brand.soft}",
      "rankFirstColor": "{status.danger}",
      "rankSecondColor": "{status.warning}",
      "rankThirdColor": "{status.success}"
    },

    "collection": {
      "coverSize": 140
    },

    "table": {
      "coverSize": 28,
      "coverRadius": "6px",
      "coverGap": 10
    }
  }
}
