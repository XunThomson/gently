{
  "meta": {
    "name": "Gently Default",
    "version": "1.0.0",
    "description": "全局 UI 样式元数据。所有主要渲染相关元数据（尺寸/颜色/字体/圆角/动效）都在此维护，运行时由 ThemeProvider 注入为 CSS 变量。"
  },

  "mode": "system",

  "palette": {
    "brand": "#6b4eff",
    "brandHover": "#5c3fe8",
    "brandSoft": "rgba(107, 78, 255, 0.10)",
    "brandContrast": "#ffffff",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444"
  },

  "scheme": {
    "light": {
      "app": "#f0f0f0",
      "surface": "#ffffff",
      "surfaceAlt": "#f3f4f6",
      "subtle": "#f7f8fa",
      "elevated": "#ffffff",
      "hover": "rgba(0, 0, 0, 0.04)",
      "active": "rgba(0, 0, 0, 0.08)",
      "textPrimary": "#1a1a1a",
      "textSecondary": "#6b7280",
      "textTertiary": "#9ca3af",
      "textInverse": "#ffffff",
      "borderSubtle": "#e5e7eb",
      "borderDefault": "#d1d5db",
      "borderStrong": "#9ca3af",
      "divider": "rgba(0, 0, 0, 0.08)",
      "scrollbarThumb": "#d9dde3"
    },
    "dark": {
      "app": "#121212",
      "surface": "#1e1e1e",
      "surfaceAlt": "#2a2a2a",
      "subtle": "#141414",
      "elevated": "#2a2a2a",
      "hover": "rgba(255, 255, 255, 0.06)",
      "active": "rgba(255, 255, 255, 0.10)",
      "textPrimary": "#ffffff",
      "textSecondary": "#d1d5db",
      "textTertiary": "#9ca3af",
      "textInverse": "#1a1a1a",
      "borderSubtle": "#3a3a3a",
      "borderDefault": "#4a4a4a",
      "borderStrong": "#6b7280",
      "divider": "rgba(255, 255, 255, 0.08)",
      "scrollbarThumb": "#3a3f46"
    }
  },

  "typography": {
    "fontFamilySans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "fontFamilyMono": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace",
    "fontSizeXs": "0.75rem",
    "fontSizeSm": "0.875rem",
    "fontSizeBase": "1rem",
    "fontSizeLg": "1.125rem",
    "fontSizeXl": "1.25rem",
    "fontSize2xl": "1.5rem",
    "fontSize3xl": "1.875rem",
    "fontSize4xl": "2.25rem",
    "lineHeightTight": 1.2,
    "lineHeightNormal": 1.5,
    "lineHeightRelaxed": 1.65,
    "weightNormal": 400,
    "weightMedium": 500,
    "weightSemibold": 600,
    "weightBold": 700
  },

  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "full": "9999px"
  },

  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },

  "shadow": {
    "xs": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "sm": "0 1px 3px rgba(0, 0, 0, 0.10)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.10)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.10)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.12)",
    "panel": "0 16px 34px -16px rgba(16, 20, 28, 0.24), 0 2px 6px rgba(16, 20, 28, 0.06)"
  },

  "motion": {
    "fast": "150ms ease",
    "base": "250ms ease",
    "slow": "350ms ease",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  },

  "zIndex": {
    "base": 0,
    "dropdown": 60,
    "overlay": 100,
    "modal": 200,
    "toast": 300
  },

  "components": {
    "titleBar": {
      "height": 60,
      "paddingX": 16,
      "logoFontSize": 20,
      "logoFontWeight": 700,
      "logoColor": "{text.primary}"
    },

    "searchBox": {
      "height": 36,
      "maxWidth": 560,
      "minWidth": 220,
      "radius": "10px",
      "fontSize": 14,
      "placeholderColor": "{text.tertiary}",
      "iconSize": 16,
      "iconColor": "{text.tertiary}",
      "submitTextColor": "{brand.contrast}",
      "panelMaxHeight": 380,
      "historyKey": "gently:search-history",
      "maxHistory": 10,
      "debounce": 250
    },

    "toolbar": {
      "buttonSize": 32,
      "iconSize": 18,
      "gap": 4,
      "paddingX": 10,
      "paddingY": 6,
      "radius": "10px",
      "iconColor": "{text.secondary}",
      "hoverColor": "{text.primary}",
      "hoverBg": "{bg.hover}",
      "dividerColor": "{border.subtle}"
    },

    "sidebar": {
      "width": 200,
      "padding": 8,
      "itemHeight": 40,
      "itemGap": 12,
      "itemPaddingX": 16,
      "itemRadius": "8px",
      "fontSize": 14,
      "iconSize": 16,
      "textColor": "{text.secondary}",
      "hoverTextColor": "{text.primary}",
      "hoverBg": "{bg.hover}",
      "activeTextColor": "{brand}",
      "activeBg": "{brand.soft}",
      "sectionTitleFontSize": 13,
      "sectionTitleColor": "{text.tertiary}"
    },

    "playerBar": {
      "height": 76,
      "paddingX": 22,
      "coverSize": 46,
      "coverRadius": "10px",
      "controlSize": 36,
      "progressWidth": 340,
      "progressHeight": 4
    },

    "view": {
      "titleFontSize": 24,
      "titleFontWeight": 700,
      "paddingX": 24,
      "paddingY": 20,
      "gap": 16,
      "maxWidth": 1360
    },

    "section": {
      "titleFontSize": 17,
      "subtitleFontSize": 12.5,
      "gap": 16,
      "marginBottom": 32
    },

    "dataTable": {
      "fontSize": 14,
      "headerFontSize": 13,
      "headerColor": "{text.secondary}",
      "cellPaddingX": 16,
      "cellPaddingY": 12,
      "radius": "10px",
      "rowHoverBg": "{bg.hover}",
      "borderColor": "{border.subtle}",
      "emptyPaddingY": 40
    },

    "card": {
      "radius": "14px",
      "gap": 18,
      "minWidth": 152,
      "coverRatio": 1,
      "titleFontSize": 13.5,
      "metaFontSize": 12
    },

    "chart": {
      "rankColumnWidth": 34,
      "coverColumnWidth": 44,
      "heatColumnWidth": 110,
      "durationColumnWidth": 52,
      "rowPaddingY": 9,
      "rowPaddingX": 18,
      "heatBarHeight": 4
    }
  }
}
